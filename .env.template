# ========================================================================
# DON YEYO MANAGER - VARIABLES DE ENTORNO GLOBALES
# ========================================================================

# --- ENTORNO GENERAL ---
NODE_ENV=development

# --- BACKEND (SERVER) ---
PORT=3001
HOST=0.0.0.0

# --- BASE DE DATOS MYSQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=dy_manager
DB_CONNECTION_LIMIT=10

# --- SEGURIDAD & CORS ---
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_don_yeyo_2026_manager

# --- MICROSOFT SSO (AZURE AD / ENTRA ID) ---
# Obtener de Azure Portal -> App Registrations
VITE_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# --- BYPASS DE AUTENTICACIÓN PARA DESARROLLO LOCAL (MOCK AUTH) ---
# Setea en 'true' para probar localmente sin requerir Azure AD activo
VITE_MOCK_AUTH=true
VITE_MOCK_AUTH_EMAIL=admin@donyeyo.com.ar
VITE_MOCK_AUTH_NAME=Administrador Don Yeyo

# --- URL BASE DE LA API EN EL CLIENTE ---
VITE_API_URL=http://localhost:3001/api
