# ========================================================================
# DON YEYO MANAGER - VARIABLES DE ENTORNO GLOBALES
# ========================================================================

# --- ENTORNO GENERAL ---
NODE_ENV=development

# --- BACKEND (SERVER) ---
PORT=3001
HOST=0.0.0.0

# --- BASE DE DATOS MYSQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=dy_manager
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000

# --- SEGURIDAD & CORS ---
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_don_yeyo_2026_manager

# --- MICROSOFT SSO (AZURE AD / ENTRA ID) ---
# Obtener de Azure Portal -> App Registrations
VITE_AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# --- DETECTOR DE CONEXIÓN A BASE DE DATOS ---
# Frecuencia en segundos para comprobar la salud de la BD (DbConnectionGuard)
VITE_DB_CONNECTION_CHECK_INTERVAL=90

# --- BYPASS DE AUTENTICACIÓN PARA DESARROLLO LOCAL (MOCK AUTH) ---
# Setea en 'true' para probar localmente sin requerir Azure AD activo
VITE_MOCK_AUTH=true
VITE_MOCK_AUTH_EMAIL=admin@donyeyo.com.ar
VITE_MOCK_AUTH_NAME=Administrador Don Yeyo

# --- URL BASE DE LA API EN EL CLIENTE ---
VITE_API_URL=http://localhost:3001/api

# --- CONFIGURACIÓN SMTP (SOLICITUDES DE ACCESO) ---
ALERTA_SMTP_HOST=smtp-mail.outlook.com
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER=soporte@donyeyo.com.ar
ALERTA_SMTP_PASSWORD=tu_password_o_app_password
ALERTA_SMTP_NAME="Don Yeyo Manager"
EMAIL_DESTINATARIOS_SOLICITUDES=admin@donyeyo.com.ar

